# Copy to .env, then run:  host/scripts/gen-env.sh --write .env
# gen-env.sh fills the host-specific values marked (auto).

# --- Host topology (auto) --------------------------------------------------
# P-core logical CPUs (both hyperthreads) for the main LLM.
MAIN_CPUSET=
# One decode thread per physical P-core; batch/prefill may use the siblings too.
MAIN_THREADS=6
MAIN_THREADS_BATCH=12
# E-cores (not LP E-cores) for everything else.
AUX_CPUSET=
# Group that owns /dev/dri/renderD* and /dev/accel/accel0, and the Intel render node.
RENDER_GID=
INTEL_RENDER_NODE=/dev/dri/renderD128

# --- Network exposure --------------------------------------------------------
# Raw model APIs stay on localhost; only the UIs listen on the LAN (bond0).
BIND_ADDR=127.0.0.1
WEBUI_BIND_ADDR=0.0.0.0
WEBUI_PORT=3000
ANYTHINGLLM_PORT=3001
# openssl rand -hex 32
WEBUI_SECRET_KEY=

# --- Main model: RTX 5060 Ti + DDR5 -----------------------------------------
# Default: gpt-oss-120b (MoE, ~5B active, ~63 GB MXFP4). Fits 16 GB VRAM + 96 GB RAM
# with room left for the iGPU model. Lower MAIN_N_CPU_MOE until VRAM is ~90% full.
MAIN_MODEL_ARGS=-hf ggml-org/gpt-oss-120b-GGUF
MAIN_N_CPU_MOE=30
MAIN_CTX=32768
MAIN_PARALLEL=1
MAIN_EXTRA_ARGS=

# Alternatives (swap MAIN_MODEL_ARGS / MAIN_N_CPU_MOE):
#   8 GB card, fast:        -hf unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF:Q4_K_M   N_CPU_MOE=48 (all layers)
#   16 GB card, fast:       -hf unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF:Q4_K_M   N_CPU_MOE=20
#   Dense 70B (slow, ~2 t/s): -hf unsloth/Llama-3.3-70B-Instruct-GGUF:Q4_K_M
#                           N_CPU_MOE=0 and MAIN_NGL=24 of 80 layers on a 16 GB card
#   Stretch, stop llm-aux:  Qwen3-235B-A22B-Instruct-2507 at ~2-3 bpw (~85-95 GB)
#   NOT feasible here:      DeepSeek-V3/R1 671B - even 1.58-bit is ~131 GB > 96+16 GB.
MAIN_NGL=999
LLAMA_CPP_REF=master
CUDA_ARCH=120

# --- Aux model: Arc iGPU (Vulkan) --------------------------------------------
# Small instruct model for titles, tags, query rewriting, summarising tool output.
AUX_MODEL_ARGS=-hf unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M
AUX_CTX=16384
AUX_PARALLEL=2
AUX_EXTRA_ARGS=
LLAMA_VULKAN_TAG=server-vulkan

# --- NPU worker (OpenVINO GenAI) -----------------------------------------------
# HF repo id or local dir. Non-OpenVINO repos are exported on first start.
EMBED_MODEL=BAAI/bge-base-en-v1.5
# cls for BGE, mean for e5/MiniLM, last_token for Qwen3-Embedding
EMBED_POOLING=cls
EMBED_MAX_LENGTH=512
EMBED_DEVICES=NPU,CPU
STT_MODEL=openai/whisper-base
STT_DEVICES=NPU,CPU
NPU_DRIVER_TAG=latest
NPU_WITH_EXPORTER=1
HF_TOKEN=

# --- Paths / image tags --------------------------------------------------------
MODELS_DIR=./models
OPEN_WEBUI_TAG=main
ANYTHINGLLM_TAG=latest
